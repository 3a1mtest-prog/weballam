# ── الدومين ────────────────────────────────────────────────────────────────
# يُستخدم في metadataBase و Open Graph و sitemap.xml و robots.txt.
# اضبطه على الدومين الحقيقي في الإنتاج. إذا تُرك فارغاً على Vercel، يستخدم
# الموقع دومين النشر تلقائياً.

NEXT_PUBLIC_SITE_URL=https://www.alghazawe.store

# ── Supabase (اختياري بالكامل) ─────────────────────────────────────────────
# Project Settings → API في لوحة Supabase.
#
# بدون هذه المفاتيح يعمل الموقع ويعرض الكتالوج المدمج في src/lib/catalog.ts،
# وتُسجَّل الطلبات في اللوق بدل قاعدة البيانات — ورسالة الواتساب تصل في الحالتين.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# اختياري. يُستخدم من جهة الخادم فقط في /api/orders.
# لا تعرضه للمتصفح ولا ترفع قيمته الحقيقية إلى Git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
