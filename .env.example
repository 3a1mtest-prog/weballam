# ── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
# Without these the site still runs and renders the bundled catalog from
# src/lib/catalog.ts; orders are logged instead of stored.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Only used server-side by /api/orders. Never expose this to the
# browser and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
